# Build-time fetched dependencies (populated by BUILD.py)
/vendor/

# Builds
/vcpkg/
/vcpkg_installed/
/build/
/*build-*/
/.build_tmp/
/dist/
/rust/target/
/rust/target-*/
# Standalone no-GPU probe crates are separate Cargo workspaces
/no-gpu-probes/*/target/
/no-gpu-probes/*/Cargo.lock

# Exports
/project_context.json

# ---> VisualStudioCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.vscode/.venv/

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# ---> Python
__pycache__/

# ---> macOS
.DS_Store
