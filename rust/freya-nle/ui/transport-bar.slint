import { Slider, SpinBox } from "std-widgets.slint";
import { TimeFormat } from "chrome.slint";
import { AppTheme } from "theme.slint";
import { StereoAudioMeter, TransportButton } from "widgets.slint";

// Player control bar: time, gauge, transport, then audio and speed.
//
// AviUtl2 puts one of these under the preview and reads it left to right as
// time -> gauge -> transport. The same bar serves the preview window and the
// timeline's merged preview pane; `compact` drops the audio and speed groups,
// which the timeline does not project.
export component TransportBar inherits Rectangle {
    in property <float> playhead: 0;
    in property <float> duration: 3600;
    in property <int> playhead-frame: 0;
    in property <int> frame-rate: 60;
    in property <bool> playing: false;
    in-out property <int> playback-speed-percent: 100;
    in property <string> playback-speed-multiplier: "1.0x";
    in property <float> audio-peak-left: 0;
    in property <float> audio-peak-right: 0;
    in property <float> audio-rms-left: 0;
    in property <float> audio-rms-right: 0;
    in property <string> audio-output-status: "";
    in property <bool> compact: false;
    // The menu accelerators must stand aside while the speed box is edited;
    // the host checks this instead of reaching into the widget. The SpinBox
    // reports it, because the group below is conditional and an `if` scopes
    // the widget's id to its own block.
    out property <bool> speed-editing: false;

    callback seek(float);
    callback previous-frame();
    callback toggle-playback();
    callback next-frame();
    callback playback-speed-changed(int);

    height: AppTheme.player-control-height;
    background: AppTheme.raised-background;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 3px;
        padding-bottom: 3px;
        // 8px keeps the natural-width speed spin box clear of the right
        // padding at the 640px default window width.
        spacing: 8px;
        Text {
            text: TimeFormat.timecode(root.playhead-frame, root.frame-rate);
            color: AppTheme.timecode;
            font-family: "Monospace";
            font-size: 0.78rem;
            vertical-alignment: center;
            accessible-label: @tr("Playback position");
        }
        seek-slider := Slider {
            value: root.playhead;
            minimum: 0;
            maximum: root.duration;
            horizontal-stretch: 1;
            accessible-label: @tr("Seek Bar");
            accessible-description: @tr("Drag to change playback position on the timeline");
            changed => { root.seek(self.value); }
        }
        HorizontalLayout {
            min-width: 96px;
            max-width: 96px;
            horizontal-stretch: 0;
            spacing: 0px;
            TransportButton { symbol: "previous"; accessible-name: @tr("Back 1 Frame"); help-text: @tr("Move playback position 1 frame back"); clicked => { root.previous-frame(); } }
            TransportButton { symbol: root.playing ? "pause" : "play"; active: root.playing; accessible-name: root.playing ? @tr("Pause") : @tr("Play"); help-text: @tr("Start or pause playback"); clicked => { root.toggle-playback(); } }
            TransportButton { symbol: "next"; accessible-name: @tr("Forward 1 Frame"); help-text: @tr("Move playback position 1 frame forward"); clicked => { root.next-frame(); } }
        }
        if !root.compact : StereoAudioMeter {
            // 58px keeps the transport row inside the 640px default window
            // even with a translated speed label.
            width: 58px;
            height: 28px;
            peak-left: root.audio-peak-left;
            peak-right: root.audio-peak-right;
            rms-left: root.audio-rms-left;
            rms-right: root.audio-rms-right;
        }
        if !root.compact : Text {
            text: @tr("Audio unavailable");
            visible: root.audio-output-status != "";
            // A long device error must not push the speed control past the
            // right edge; the full text stays available to assistive
            // technology through the description.
            max-width: 120px;
            overflow: elide;
            color: AppTheme.danger;
            font-size: 0.72rem;
            vertical-alignment: center;
            accessible-description: root.audio-output-status;
        }
        if !root.compact : HorizontalLayout {
            // Size to its content instead of a fixed 130px. The label, the
            // native SpinBox, and the "1.0x" multiplier need more than that,
            // so the fixed width clipped the multiplier at the window edge.
            min-width: 150px;
            horizontal-stretch: 0;
            spacing: 5px;
            Text { text: @tr("Speed"); vertical-alignment: center; }
            speed-input := SpinBox {
                // Let the widget use its natural width. A fixed 80px is
                // narrower than the spin buttons need, so the theme drew the
                // lower button outside the box, on top of "1.0x".
                height: 28px;
                value <=> root.playback-speed-percent;
                minimum: 10;
                maximum: 400;
                step-size: 10;
                enabled: !root.playing;
                accessible-label: @tr("Playback speed (percent)");
                accessible-description: root.playback-speed-multiplier;
                edited(value) => { root.playback-speed-changed(value); }
                changed has-focus => { root.speed-editing = self.has-focus; }
            }
            // Qt renders the box as a multiplier, e.g. "1.0x"
            // (MainWindow.qml:1143). Slint's SpinBox has no text formatter,
            // so the percent value stays native and the matching multiplier is
            // shown beside it.
            Text {
                text: root.playback-speed-multiplier;
                vertical-alignment: center;
                color: AppTheme.muted-foreground;
            }
        }
    }
}
