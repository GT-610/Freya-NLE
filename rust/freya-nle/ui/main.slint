import { ProjectTabData, MissingMediaData, TimelineMarkData } from "models.slint";
import { Button, ScrollView } from "std-widgets.slint";
import { FooterBar } from "chrome.slint";
import { AppTheme } from "theme.slint";
import { ProjectTab } from "timeline-items.slint";
import { TabAddButton } from "widgets.slint";
import { TransportBar } from "transport-bar.slint";

export component MainWindow inherits Window {
    title: @tr("Freya NLE - Preview");
    preferred-width: 640px;
    preferred-height: 360px;
    min-width: 480px;
    min-height: 300px;
    background: AppTheme.window-background;
    forward-focus: main-shortcuts;

    in property <[ProjectTabData]> project-tabs;
    // Both windows carry the same menu bar, so the mark list is projected to
    // both instead of disappearing when focus moves to the preview window.
    in property <[TimelineMarkData]> marks;
    in property <bool> mark-at-playhead: false;
    in property <[keys]> menu-shortcuts;
    in property <[MissingMediaData]> missing-media;
    in property <int> current-project: -1;
    in property <image> preview-image;
    in-out property <float> playhead: 0;
    in property <float> duration: 3600;
    in property <bool> playing: false;
    in-out property <int> playback-speed-percent: 100;
    in property <string> playback-speed-multiplier: "1.0x";
    in property <string> status-text: "Ready";
    in property <string> frame-counter-text: "0 / 0";
    // Integer frame position and rate for the transport timecode. The host
    // projects them with the rest of the transport state.
    in property <int> playhead-frame: 0;
    in property <int> frame-rate: 60;
    in property <float> audio-peak-left: 0;
    in property <float> audio-peak-right: 0;
    in property <float> audio-rms-left: 0;
    in property <float> audio-rms-right: 0;
    in property <string> audio-output-status: "";
    in property <bool> save-confirmation-visible: false;
    // Mirrors the timeline's merged-preview state so the workspace item can
    // say what it will do; the host keeps it in step.
    in-out property <bool> merged-workspace: false;
    in-out property <bool> missing-media-dialog-visible: false;
    in property <int> project-tab-height: 28;

    callback new-project();
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback export-media();
    callback import-exo-object-file();
    callback new-project-from-exo-file();
    callback import-fragment();
    callback export-fragment();
    callback quit-requested();
    callback undo();
    callback redo();
    callback toggle-mark();
    callback remove-mark();
    callback edit-mark-note();
    callback next-mark();
    callback previous-mark();
    callback clear-marks();
    callback seek-to-mark(int);
    callback show-project-settings();
    callback show-system-settings();
    callback show-timeline();
    callback show-preview-window();
    callback adjust-preview-height(float);
    callback show-timeline-media-library();
    callback choose-edit-tool(string);
    callback show-object-settings();
    callback show-package-manager();
    callback show-about();
    callback relink-missing-media(int);
    callback select-project(int);
    callback close-project(int);
    callback seek(float);
    callback previous-frame();
    callback toggle-playback();
    callback next-frame();
    callback playback-speed-changed(int);
    callback keyboard-shortcut(string, bool, bool, bool, bool) -> bool;
    callback workspace-action(string);
    private property <keys> no-shortcut;
    private property <bool> menu-accelerators-enabled: !transport.speed-editing && !root.missing-media-dialog-visible;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New Project"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[0] : root.no-shortcut; icon: @image-url("icons/new.svg"); enabled: !root.save-confirmation-visible; activated => { root.new-project(); } }
            MenuItem { title: @tr("Open Project"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[1] : root.no-shortcut; icon: @image-url("icons/open.svg"); enabled: !root.save-confirmation-visible; activated => { root.open-project(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Save Project"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[2] : root.no-shortcut; icon: @image-url("icons/save.svg"); enabled: !root.save-confirmation-visible; activated => { root.save-project(); } }
            MenuItem { title: @tr("Save Project As..."); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[3] : root.no-shortcut; icon: @image-url("icons/save.svg"); enabled: !root.save-confirmation-visible; activated => { root.save-project-as(); } }
            MenuItem {
                title: @tr("Manage Missing Media");
                enabled: !root.save-confirmation-visible && root.missing-media.length > 0;
                activated => { root.missing-media-dialog-visible = true; }
            }
            MenuSeparator { }
            MenuItem { title: @tr("Insert Fragment..."); enabled: !root.save-confirmation-visible; activated => { root.import-fragment(); } }
            MenuItem { title: @tr("Export Fragment..."); enabled: !root.save-confirmation-visible; activated => { root.export-fragment(); } }
            MenuSeparator { }
            MenuItem { title: @tr("New Project from AviUtl Object File..."); enabled: !root.save-confirmation-visible; activated => { root.new-project-from-exo-file(); } }
            MenuItem { title: @tr("Import AviUtl Object File (Compatibility)..."); enabled: !root.save-confirmation-visible; activated => { root.import-exo-object-file(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Export Media..."); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[4] : root.no-shortcut; icon: @image-url("icons/export.svg"); enabled: !root.save-confirmation-visible; activated => { root.export-media(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Exit"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[5] : root.no-shortcut; icon: @image-url("icons/close.svg"); enabled: !root.save-confirmation-visible; activated => { root.quit-requested(); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: @tr("Undo"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[7] : root.no-shortcut; icon: @image-url("icons/undo.svg"); enabled: !root.save-confirmation-visible; activated => { root.undo(); } }
            MenuItem { title: @tr("Redo"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[8] : root.no-shortcut; icon: @image-url("icons/redo.svg"); enabled: !root.save-confirmation-visible; activated => { root.redo(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Selection Tool"); activated => { root.choose-edit-tool("select"); } }
            MenuItem { title: @tr("Ripple Trim"); activated => { root.choose-edit-tool("ripple"); } }
            MenuItem { title: @tr("Roll Edit"); activated => { root.choose-edit-tool("roll"); } }
            MenuItem { title: @tr("Slide Clip"); activated => { root.choose-edit-tool("slide"); } }
            MenuItem { title: @tr("Slip Media"); activated => { root.choose-edit-tool("slip"); } }
            MenuSeparator { }
            // The timeline owns the mark commands; this window forwards them so
            // the menu bar reads the same whichever editor window has focus.
            Menu {
                title: @tr("Marks");
                MenuItem {
                    title: @tr("Mark Current Frame");
                    shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[34] : root.no-shortcut;
                    enabled: !root.save-confirmation-visible && !root.mark-at-playhead;
                    activated => { root.toggle-mark(); }
                }
                MenuItem {
                    title: @tr("Remove Mark");
                    enabled: !root.save-confirmation-visible && root.mark-at-playhead;
                    activated => { root.remove-mark(); }
                }
                MenuItem {
                    title: @tr("Edit Mark Note...");
                    shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[35] : root.no-shortcut;
                    enabled: !root.save-confirmation-visible && root.mark-at-playhead;
                    activated => { root.edit-mark-note(); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Next Mark");
                    shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[36] : root.no-shortcut;
                    enabled: !root.save-confirmation-visible;
                    activated => { root.next-mark(); }
                }
                MenuItem {
                    title: @tr("Previous Mark");
                    shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[37] : root.no-shortcut;
                    enabled: !root.save-confirmation-visible;
                    activated => { root.previous-mark(); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Clear Marks");
                    enabled: !root.save-confirmation-visible && root.marks.length > 0;
                    activated => { root.clear-marks(); }
                }
                for mark in root.marks : MenuItem {
                    title: mark.label;
                    enabled: !root.save-confirmation-visible;
                    activated => { root.seek-to-mark(mark.frame); }
                }
            }
        }
        Menu {
            title: @tr("Settings");
            MenuItem { title: @tr("Project Settings"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[23] : root.no-shortcut; icon: @image-url("icons/settings.svg"); enabled: !root.save-confirmation-visible; activated => { root.show-project-settings(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Preferences"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[6] : root.no-shortcut; icon: @image-url("icons/settings.svg"); enabled: !root.save-confirmation-visible; activated => { root.show-system-settings(); } }
        }
        Menu {
            title: @tr("View");
            // The media library belongs to the timeline window; this item only toggles it there,
            // so both windows keep an identical menu bar for macOS focus switching.
            MenuItem { title: @tr("Media Library"); activated => { root.show-timeline-media-library(); } }
            MenuItem { title: @tr("Taller preview"); activated => { root.adjust-preview-height(40); } }
            MenuItem { title: @tr("Shorter preview"); activated => { root.adjust-preview-height(-40); } }
            MenuItem { title: @tr("Show Preview Window"); icon: @image-url("icons/timeline.svg"); activated => { root.show-preview-window(); } }
            MenuItem { title: @tr("Show Timeline"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[21] : root.no-shortcut; icon: @image-url("icons/timeline.svg"); enabled: !root.save-confirmation-visible; activated => { root.show-timeline(); } }
            MenuItem { title: @tr("Show Settings Dialog"); shortcut: root.menu-accelerators-enabled ? root.menu-shortcuts[22] : root.no-shortcut; icon: @image-url("icons/settings.svg"); enabled: !root.save-confirmation-visible; activated => { root.show-object-settings(); } }
            Menu {
                title: @tr("Workspace");
                MenuItem {
                    title: root.merged-workspace ? @tr("Separate workspace") : @tr("Merge workspace");
                    enabled: !root.save-confirmation-visible;
                    activated => { root.workspace-action(root.merged-workspace ? "separate" : "merged"); }
                }
                MenuSeparator { }
                MenuItem { title: @tr("Editing layout"); enabled: !root.save-confirmation-visible; activated => { root.workspace-action("editing"); } }
                MenuItem { title: @tr("Animation layout"); enabled: !root.save-confirmation-visible; activated => { root.workspace-action("animation"); } }
                MenuItem { title: @tr("Audio layout"); enabled: !root.save-confirmation-visible; activated => { root.workspace-action("audio"); } }
                MenuSeparator { }
                MenuItem { title: @tr("Save current layout"); enabled: !root.save-confirmation-visible; activated => { root.workspace-action("save"); } }
                MenuItem { title: @tr("Restore saved layout"); enabled: !root.save-confirmation-visible; activated => { root.workspace-action("restore"); } }
                MenuItem { title: @tr("Bring editor windows onto this screen"); enabled: !root.save-confirmation-visible; activated => { root.workspace-action("recover-screen"); } }
            }
        }
        Menu {
            title: @tr("Tools");
            MenuItem { title: @tr("Package Manager"); enabled: !root.save-confirmation-visible; activated => { root.show-package-manager(); } }
            MenuSeparator { }
            MenuItem { title: @tr("About"); enabled: !root.save-confirmation-visible; activated => { root.show-about(); } }
        }
    }

    main-shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if !root.save-confirmation-visible && root.menu-accelerators-enabled && root.keyboard-shortcut(
                event.text,
                event.modifiers.alt,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.meta
            ) {
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0px;
            Rectangle {
            height: root.project-tab-height * 1px;
            background: AppTheme.raised-background;
            HorizontalLayout {
                spacing: 0px;
                // Many open projects overflow the strip, so the tabs scroll
                // horizontally while the add button stays pinned, as Qt does
                // with its ScrollView plus trailing button (MainWindow.qml:827-929).
                project-tab-scroll := ScrollView {
                    horizontal-stretch: 1;
                    height: 100%;
                    viewport-width: max(project-tab-list.preferred-width, self.visible-width);
                    viewport-height: self.visible-height;
                    mouse-drag-pan-enabled: false;
                    project-tab-list := HorizontalLayout {
                        spacing: 0px;
                        accessible-role: tab-list;
                        accessible-label: @tr("Project");
                        for tab[index] in root.project-tabs: ProjectTab {
                            label: tab.name + (tab.dirty ? " *" : "");
                            selected: root.current-project == index;
                            tab-height: root.project-tab-height * 1px;
                            activate => { root.select-project(index); }
                            close => { root.close-project(index); }
                        }
                    }
                }
                TabAddButton { accessible-name: @tr("New Project"); clicked => { root.new-project(); } }
            }
        }
            Rectangle {
            vertical-stretch: 1;
            background: AppTheme.canvas-background;
            Image {
                source: root.preview-image;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }
        }
            transport := TransportBar {
                playhead: root.playhead;
                duration: root.duration;
                playhead-frame: root.playhead-frame;
                frame-rate: root.frame-rate;
                playing: root.playing;
                playback-speed-percent <=> root.playback-speed-percent;
                playback-speed-multiplier: root.playback-speed-multiplier;
                audio-peak-left: root.audio-peak-left;
                audio-peak-right: root.audio-peak-right;
                audio-rms-left: root.audio-rms-left;
                audio-rms-right: root.audio-rms-right;
                audio-output-status: root.audio-output-status;
                seek(value) => { root.seek(value); }
                previous-frame => { root.previous-frame(); }
                toggle-playback => { root.toggle-playback(); }
                next-frame => { root.next-frame(); }
                playback-speed-changed(percent) => { root.playback-speed-changed(percent); }
            }
        // The workspace reports the result of every edit ("Added effect ...",
        // "Relinked media to ...") and the reason a command was refused. Those
        // messages used to be projected into a property nothing rendered, so a
        // rejected action looked like a no-op.
        FooterBar {
            left-text: root.status-text;
            right-text: root.frame-counter-text;
            monospace-left: false;
        }
        }
    }

    if root.missing-media.length > 0 : Rectangle {
        z: 100;
        width: min(430px, root.width - 24px);
        height: 42px;
        x: root.width - self.width - 12px;
        y: root.height - self.height - 12px;
        background: AppTheme.control-background;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: 5px;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            spacing: 8px;
            Text {
                text: @tr("{} missing media files", root.missing-media.length);
                color: AppTheme.foreground;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Manage");
                accessible-label: @tr("Manage Missing Media");
                clicked => { root.missing-media-dialog-visible = true; }
            }
        }
    }

    if root.missing-media-dialog-visible : missing-media-focus := FocusScope {
        z: 900;
        width: min(root.width - 32px, 560px);
        height: min(root.height - 32px, 360px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        // The focus waits for the next event-loop turn: taking it while the
        // overlay is being created re-enters the backend's accessibility
        // borrow (see the object-settings overlays).
        init => { missing-media-focus-timer.start(); }
        missing-media-focus-timer := Timer {
            interval: 1ms;
            running: false;
            triggered => { self.stop(); missing-media-focus.focus(); }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.missing-media-dialog-visible = false;
                accept
            } else {
                reject
            }
        }

        Rectangle {
            background: AppTheme.raised-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 6px;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                Text {
                    text: @tr("Missing Media");
                    color: AppTheme.foreground;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    viewport-height: missing-media-list.preferred-height;
                    missing-media-list := VerticalLayout {
                        width: parent.width;
                        spacing: 6px;
                        for media in root.missing-media : Rectangle {
                            height: 64px;
                            background: AppTheme.panel-background;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: media.clip-type + ": " + media.name;
                                        color: AppTheme.foreground;
                                        font-weight: 700;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: media.path;
                                        color: AppTheme.muted-foreground;
                                        font-size: 0.78rem;
                                        overflow: elide;
                                    }
                                }
                                Button {
                                    text: @tr("Replace");
                                    accessible-label: @tr("Replace Missing Media");
                                    clicked => { root.relink-missing-media(media.clip-id); }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: @tr("Close");
                        clicked => { root.missing-media-dialog-visible = false; }
                    }
                }
            }
        }
    }

}
