import { Button, LineEdit } from "std-widgets.slint";
import { AppTheme } from "theme.slint";

// The note attached to one frame mark, edited in its own window.
//
// AviUtl2 edits a mark's note from the mark list context menu and opens the
// text editor in place. A separate window is used here for the same reasons the
// save confirmation moved out of the preview: the dialog can be placed on its
// own screen and does not move with the timeline.
export component MarkNoteWindow inherits Window {
    title: @tr("Mark Note");
    preferred-width: 440px;
    preferred-height: 190px;
    min-width: 360px;
    min-height: 170px;
    background: AppTheme.dialog-background;

    // The frame the note belongs to. The host reads it back on save instead of
    // keeping a second copy of "which mark is being edited".
    in property <int> frame: 0;
    in property <string> frame-text: "";
    in-out property <string> note: "";

    callback save-note(int, string);
    callback cancel-note();

    forward-focus: dialog-focus;

    dialog-focus := FocusScope {
        width: 100%;
        height: 100%;
        // Taking focus while the window is being created re-enters the backend's
        // accessibility borrow, so it waits for the next event-loop turn.
        init => { dialog-focus-timer.start(); }
        dialog-focus-timer := Timer {
            interval: 1ms;
            running: false;
            triggered => { self.stop(); note-field.focus(); }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel-note();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: AppTheme.dialog-background;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: @tr("Mark Note");
                    color: AppTheme.dialog-foreground;
                    font-size: 1.15rem;
                    font-weight: 700;
                }
                Text {
                    text: root.frame-text;
                    color: AppTheme.dialog-muted;
                    overflow: elide;
                }
                note-field := LineEdit {
                    text <=> root.note;
                    placeholder-text: @tr("Note for this mark (optional)");
                    accessible-label: @tr("Mark Note");
                    accepted(value) => { root.save-note(root.frame, value); }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: @tr("Cancel");
                        accessible-label: @tr("Cancel");
                        clicked => { root.cancel-note(); }
                    }
                    Button {
                        text: @tr("Save");
                        accessible-label: @tr("Save");
                        clicked => { root.save-note(root.frame, root.note); }
                    }
                }
            }
        }
    }
}
