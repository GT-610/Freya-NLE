import { ComboBox, ScrollView } from "std-widgets.slint";
import { PanelHeader } from "chrome.slint";
import { TimelineObjectData } from "models.slint";
import { AppTheme } from "theme.slint";

// AviUtl2's オブジェクトリスト: the objects that cover the current frame.
//
// The list is a navigation aid, not a second timeline: a single click selects
// the object (the layer and object settings follow), a double click also opens
// its settings, and a right click opens the same object menu the timeline uses
// (AviUtl2 offers its object operations from this list too).
export component ObjectListPanel inherits Rectangle {
    in property <[TimelineObjectData]> objects;
    // Rows shown after the kind filter; the header composes it from `objects`.
    in property <[string]> kind-filters;
    // The chosen label; empty means every kind.
    in-out property <string> kind-filter-value: "";
    callback filter-kinds(string);
    // Dragging a row onto another row moves that layer's objects to the target
    // layer; the list is ordered by layer, so this is the only thing a vertical
    // drag can mean.
    callback move-layer(int, int);
    // The row being dragged and how many rows the pointer has travelled. Rows
    // are fixed height, so the row count is the layer delta.
    private property <int> drag-source-layer: -1;
    private property <int> drag-delta-rows: 0;
    callback select(int);
    callback open(int);
    // Window coordinates, so the timeline can place the shared context menu.
    callback context-requested(int, length, length, bool, bool);
    callback close-requested();

    // A short glyph per object kind; the label carries the readable name.
    pure function kind-glyph(kind: string) -> string {
        if kind == "audio" {
            return "♪";
        }
        if kind == "video" {
            return "▶";
        }
        if kind == "image" {
            return "▣";
        }
        if kind == "text" || kind == "counter" {
            return "T";
        }
        if kind == "camera" || kind == "camera_control" {
            return "⌾";
        }
        if kind == "scene" {
            return "▤";
        }
        if kind == "GroupControl" {
            return "❏";
        }
        if kind == "frame_buffer" {
            return "▥";
        }
        return "◆";
    }

    VerticalLayout {
        PanelHeader {
            title: @tr("Objects at Frame");
            actions: [
                { glyph: "×", label: @tr("Hide object list"), enabled: true }
            ];
            action(index) => {
                if index == 0 {
                    root.close-requested();
                }
            }
        }
        // AviUtl2 lets the list be narrowed by object kind; with a busy frame
        // the unfiltered list is mostly noise. The first entry is "All".
        if root.kind-filters.length > 1 : Rectangle {
            // A fixed height keeps the filter a header row instead of letting
            // it absorb the panel's vertical stretch.
            height: 28px;
            ComboBox {
                x: 6px;
                width: parent.width - 12px;
                height: 26px;
                model: root.kind-filters;
                current-value: root.kind-filter-value;
                accessible-label: @tr("Filter by object kind");
                // The widget reports the chosen label, which is what the host
                // stores; the label is mapped back to a kind id there.
                selected(value) => { root.filter-kinds(value); }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            viewport-height: object-list.preferred-height;
            object-list := VerticalLayout {
                width: parent.width;
                spacing: 1px;
                for object[index] in root.objects : Rectangle {
                    height: 28px;
                    background: object.selected
                        ? AppTheme.selection-background
                        : object-touch.has-hover ? AppTheme.hover-background : transparent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        Text {
                            text: "\{object.layer + 1}";
                            width: 20px;
                            color: AppTheme.muted-foreground;
                            font-size: 0.76rem;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        Text {
                            text: root.kind-glyph(object.kind);
                            width: 16px;
                            color: AppTheme.muted-foreground;
                            font-size: 0.8rem;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: object.label;
                            horizontal-stretch: 1;
                            color: AppTheme.foreground;
                            font-size: 0.8rem;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: object.locked ? "L" : "";
                            color: AppTheme.warning;
                            font-size: 0.72rem;
                            vertical-alignment: center;
                        }
                    }
                    object-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: list-item;
                        accessible-label: object.label;
                        accessible-item-selectable: true;
                        accessible-item-selected: object.selected;
                        clicked => { root.select(object.clip-id); }
                        double-clicked => { root.open(object.clip-id); }
                        // A vertical drag moves this layer's objects to another
                        // layer; the list is ordered by layer, so the distance
                        // in rows is the layer delta. A plain click still
                        // selects, because the move only runs after a full row.
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down
                                && event.button == PointerEventButton.right {
                                root.context-requested(
                                    object.clip-id,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y,
                                    object.kind == "audio",
                                    object.clip-by-upper-object
                                );
                            } else if event.kind == PointerEventKind.down {
                                root.drag-source-layer = object.layer;
                                root.drag-delta-rows = 0;
                            } else if event.kind == PointerEventKind.up {
                                let delta = root.drag-delta-rows;
                                let source = root.drag-source-layer;
                                root.drag-source-layer = -1;
                                root.drag-delta-rows = 0;
                                // Rows are one per object, not one per layer, so
                                // the destination layer is read from the row the
                                // drag ended on rather than from the row count.
                                let target-index = index + delta;
                                if source == object.layer
                                    && target-index >= 0
                                    && target-index < root.objects.length {
                                    root.move-layer(
                                        source,
                                        root.objects[target-index].layer
                                    );
                                }
                            } else if event.kind == PointerEventKind.move
                                && root.drag-source-layer == object.layer {
                                // Truncated, not rounded: a pointer that has
                                // moved 15px is still inside the source row,
                                // and rounding would land on the next row and
                                // move the whole layer there. Divided by the
                                // row *pitch* — 28px of row plus the 1px
                                // spacing — because that is the distance
                                // between one row's top and the next one's.
                                root.drag-delta-rows =
                                    (self.mouse-y - self.pressed-y) / 29px;
                            }
                        }
                    }
                }
                if root.objects.length == 0 : Text {
                    text: @tr("No objects at this frame");
                    x: 8px;
                    width: parent.width - 16px;
                    color: AppTheme.muted-foreground;
                    font-size: 0.8rem;
                    wrap: word-wrap;
                }
            }
        }
    }
}
