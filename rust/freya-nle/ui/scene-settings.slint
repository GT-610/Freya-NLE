import { CheckBox, ComboBox, GroupBox, LineEdit, SpinBox } from "std-widgets.slint";
import { SettingsDialogBody } from "chrome.slint";
import { AppTheme } from "theme.slint";

export component SceneSettingsWindow inherits Window {
    title: root.creation-mode ? @tr("Create New Scene") : @tr("Scene Settings");
    preferred-width: 450px;
    preferred-height: 550px;
    min-width: 410px;
    min-height: 460px;

    background: AppTheme.dialog-background;
    forward-focus: dialog;

    in-out property <string> validation-message;
    callback apply-settings() -> bool;
    callback close-window();

    in-out property <bool> creation-mode: false;
    in-out property <int> target-scene-id: -1;
    in-out property <string> scene-name: "";
    in-out property <string> scene-label: "";
    in-out property <int> scene-width: 1920;
    in-out property <int> scene-height: 1080;
    in-out property <string> scene-fps: "60";
    in-out property <int> scene-duration: 3600;
    in-out property <int> grid-mode-index: 0;
    in-out property <string> grid-bpm: "120";
    in-out property <string> grid-offset: "0";
    in-out property <string> grid-interval: "10";
    in-out property <string> grid-subdivision: "4";
    in-out property <bool> enable-snap: true;
    in-out property <int> magnetic-snap-range: 10;

    dialog := SettingsDialogBody {
        apply-label: "OK";
        validation-message: root.validation-message;
        apply-settings => {
            let applied = root.apply-settings();
            if !applied && root.validation-message != "" { fps-input.focus(); }
            return applied;
        }
        close-window => { root.close-window(); }

        GroupBox {
            title: @tr("Basic Settings");
            GridLayout {
                padding: 10px;
                spacing: 9px;
                Row {
                    Text { text: @tr("Scene Name:"); vertical-alignment: center; }
                    LineEdit { text <=> root.scene-name; accessible-label: @tr("Scene Name:"); }
                }
                Row {
                    Text { text: @tr("Label:"); vertical-alignment: center; }
                    LineEdit {
                        text <=> root.scene-label;
                        placeholder-text: @tr("Optional label for filtering");
                        accessible-label: @tr("Label:");
                    }
                }
                Row {
                    Text { text: @tr("settings-width" => "Width:"); vertical-alignment: center; }
                    SpinBox { value <=> root.scene-width; minimum: 1; maximum: 8000; accessible-label: @tr("settings-width" => "Width:"); }
                }
                Row {
                    Text { text: @tr("settings-height" => "Height:"); vertical-alignment: center; }
                    SpinBox { value <=> root.scene-height; minimum: 1; maximum: 8000; accessible-label: @tr("settings-height" => "Height:"); }
                }
                Row {
                    Text { text: @tr("FPS:"); vertical-alignment: center; }
                    fps-input := LineEdit {
                        text <=> root.scene-fps;
                        accessible-label: @tr("FPS:");
                        accessible-description: root.validation-message;
                        edited => { root.validation-message = ""; }
                    }
                }
            }
        }
        GroupBox {
            title: @tr("Editing and Snap");
            GridLayout {
                padding: 10px;
                spacing: 9px;
                Row {
                    Text { text: @tr("Enable Snap:"); vertical-alignment: center; }
                    CheckBox { checked <=> root.enable-snap; accessible-label: @tr("Enable Snap:"); }
                }
                Row {
                    Text { text: @tr("Magnetic Snap Range:"); vertical-alignment: center; }
                    SpinBox { value <=> root.magnetic-snap-range; minimum: 1; maximum: 100; accessible-label: @tr("Magnetic Snap Range:"); }
                }
                Row {
                    Text { text: @tr("Grid Mode:"); vertical-alignment: center; }
                    ComboBox {
                        model: [@tr("Auto (Seconds/Frames)"), @tr("BPM (Music)"), @tr("Fixed Frame Count")];
                        current-index <=> root.grid-mode-index;
                        accessible-label: @tr("Grid Mode:");
                    }
                }
            }
        }
        if root.grid-mode-index == 1 : GroupBox {
            title: @tr("BPM Settings");
            GridLayout {
                padding: 10px;
                spacing: 9px;
                Row { Text { text: @tr("BPM:"); vertical-alignment: center; } LineEdit { text <=> root.grid-bpm; accessible-label: @tr("BPM:"); } }
                Row { Text { text: @tr("Time Signature (Subdivisions):"); vertical-alignment: center; } LineEdit { text <=> root.grid-subdivision; accessible-label: @tr("Time Signature (Subdivisions):"); } }
                Row { Text { text: @tr("Offset (Seconds):"); vertical-alignment: center; } LineEdit { text <=> root.grid-offset; accessible-label: @tr("Offset (Seconds):"); } }
            }
        }
        if root.grid-mode-index == 2 : GroupBox {
            title: @tr("Frame Settings");
            GridLayout {
                padding: 10px;
                spacing: 9px;
                Row { Text { text: @tr("Interval (Frames):"); vertical-alignment: center; } LineEdit { text <=> root.grid-interval; accessible-label: @tr("Interval (Frames):"); } }
            }
        }
    }
}
