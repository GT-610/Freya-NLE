# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Source files
*.rs text eol=lf
*.slint text eol=lf
*.wgsl text eol=lf
*.lua text eol=lf
*.po text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.fish text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Windows-specific files must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (do not modify line endings)
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.ttf binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.zip binary
*.7z binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary
*.lib binary
*.a binary
*.so binary
*.dylib binary
